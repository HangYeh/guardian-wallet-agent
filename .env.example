# 門神錢包 Guardian Wallet — 環境變數範本
# 複製成 .env 後填入。.env 已被 .gitignore 擋住，永遠不要 commit。
# 沒有任何金鑰也能跑：DEMO_MODE=fixtures + CHAIN_MODE=mock 可完整重現四幕 demo。

# ---- LLM（解析帳單、風險評估）----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_VISION=true

# ---- 語音（阿嬤介面唸攔截理由、週報旁白）----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ENABLE_TTS=false

# ---- Demo 模式 ----
# live     = 真的呼叫 LLM
# fixtures = 讀 fixtures/llm/ 內的快取回應，無金鑰可完整重現（評審用這個）
DEMO_MODE=live

# ---- 鏈上模式 ----
# mock    = 記憶體帳本，不需節點
# local   = Hardhat 節點（npm run chain:node）
# testnet = Base Sepolia（chainId 84532）
CHAIN_MODE=mock

# local  → http://127.0.0.1:8545
# testnet→ https://sepolia.base.org
RPC_URL=http://127.0.0.1:8545
EXPLORER_BASE=https://sepolia.basescan.org

# 金鑰分層：guardian 是根權限（改政策、核准），operator 是門神 agent 的日常代付權限。
# local 模式用 Hardhat 帳戶 #0 / #1；testnet 用 viem generatePrivateKey() 另外產生。
GUARDIAN_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=

# 部署後由 deployments/*.json 帶入，可留空
WALLET_ADDRESS=
TOKEN_ADDRESS=

# ---- 安全 ----
# 守護者介面（核准 / 拒絕 / 改政策 / 改白名單）的共用密鑰。
# demo 版用它擋掉「任何連得到這台機器的人都能核准付款」，真實版應為 passkey 或行動裝置簽章。
# 留空 = 不驗證，只有在完全離線的本機 demo 才可以這樣。
GUARDIAN_TOKEN=

# 紅隊按鈕：故意送一筆違反政策的付款，讓評審看到合約會 revert。
# 預設關閉；這是刻意製造的攻擊入口，只在 demo 時開。
ENABLE_REDTEAM=false

# 逐字稿專用模型。抄字是機械工作，用便宜快的那顆；抽欄位仍走 OPENAI_MODEL。
OPENAI_TRANSCRIBE_MODEL=gpt-4.1-nano
